# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=

# Local addition: work with a DeepSeek key instead of an OpenRouter one.
# Setting it makes LM() call api.deepseek.com with deepseek-flash for every
# role (CS329Z_JUDGE_MODEL=deepseek-v4-pro for a different judge).
# CS329Z_PROVIDER=openrouter or =deepseek picks the provider when both keys
# are set.
# DEEPSEEK_API_KEY=

# Optional overrides
# CS329Z_GRADING_MODEL=openai/gpt-6-luna  # the model LM() calls (an OpenRouter name); grading uses the default
# CS329Z_REASONING_EFFORT=low # reasoning effort for models that accept it
# CS329Z_BUDGET_USD=25        # your own stop: the LM wrapper refuses new calls once the ledger reaches this
# CS329Z_EVAL_SLICE=5         # run live tests on the first N items only
